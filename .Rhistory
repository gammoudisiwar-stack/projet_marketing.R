cat("\n==========================================")
cat("\nPROJET ANALYSE MULTIVARIEE - DATASET WINE")
cat("\n==========================================\n")
# -----------------------------------------------------------------------------
# 2. Exploration et description des données
# -----------------------------------------------------------------------------
cat("\n--- 1. DESCRIPTION DES DONNEES ---\n")
cat("\nDimensions :", dim(wine)[1], "observations x", dim(wine)[2], "variables\n")
cat("\nNoms des variables :\n")
print(names(wine))
cat("\nType de vin (variable cible) :\n")
print(table(wine$Type))
cat("\nRésumé statistique des 13 variables chimiques :\n")
print(summary(wine[,-1]))
cat("\nValeurs manquantes :", sum(is.na(wine)), "\n")
# -----------------------------------------------------------------------------
# 3. Préparation des données pour l'ACP
# -----------------------------------------------------------------------------
cat("\n--- 2. PREPARATION DES DONNEES ---\n")
# Extraction des variables quantitatives (sans la colonne Type)
wine_acp <- wine[, -1]
# Vérification de la normalité (optionnelle)
cat("\nTest de normalité (Shapiro-Wilk) sur les variables :\n")
for(i in 1:ncol(wine_acp)) {
p_val <- shapiro.test(wine_acp[,i])$p.value
cat(names(wine_acp)[i], ": p-value =", format.pval(p_val),
ifelse(p_val < 0.05, " (non normal)", " (normal approximé)"), "\n")
}
# Normalisation centrée-réduite (indispensable pour ACP)
wine_scaled <- scale(wine_acp)
cat("\nDonnées centrées-réduites : OK\n")
# Matrice de corrélation
cat("\n--- Matrice de corrélation ---\n")
cor_matrix <- cor(wine_acp)
print(round(cor_matrix, 3))
# Visualisation matrice de corrélation
corrplot(cor_matrix, method = "color", type = "upper",
tl.col = "black", tl.srt = 45, title = "Corrélations entre variables")
# -----------------------------------------------------------------------------
# 4. Analyse en Composantes Principales (ACP)
# -----------------------------------------------------------------------------
cat("\n--- 3. ANALYSE FACTORIELLE (ACP) ---\n")
# Réalisation de l'ACP
res.pca <- PCA(wine_acp, scale.unit = TRUE, graph = FALSE, ncp = 5)
# Valeurs propres et variance expliquée
cat("\n--- Valeurs propres et variance expliquée ---\n")
eigen_values <- get_eigenvalue(res.pca)
print(round(eigen_values, 3))
# Graphique de l'éboulis (variance expliquée)
fviz_eig(res.pca, addlabels = TRUE, ylim = c(0, 50),
main = "Variance expliquée par les axes factoriels")
# Qualité de représentation des variables
cat("\n--- Coordonnées et contributions des variables ---\n")
var_coord <- get_pca_var(res.pca)
cat("\nCoordonnées sur les 3 premiers axes :\n")
print(round(var_coord$coord[,1:3], 3))
cat("\nContributions aux axes 1 et 2 :\n")
print(round(var_coord$contrib[,1:2], 3))
# Cercle des corrélations (variables)
fviz_pca_var(res.pca, col.var = "contrib",
gradient.cols = c("blue", "yellow", "red"),
repel = TRUE, title = "Cercle des corrélations - Variables")
# Graphique des individus (colorés par type de vin)
fviz_pca_ind(res.pca, geom.ind = "point", col.ind = wine$Type,
palette = c("#E7B800", "#2E9FDF", "#FC4E07"),
addEllipses = TRUE, ellipse.level = 0.95,
title = "Projection des individus (vins) - ACP")
# -----------------------------------------------------------------------------
# 5. Classification (K-means)
# -----------------------------------------------------------------------------
cat("\n--- 4. CLASSIFICATION (K-MEANS) ---\n")
# Utilisation des coordonnées sur les 3 premiers axes factoriels
coords_pca <- res.pca$ind$coord[,1:3]
# Détermination du nombre optimal de clusters
cat("\n--- Détermination du nombre de clusters ---\n")
# Méthode elbow (withinss)
fviz_nbclust(coords_pca, kmeans, method = "wss") +
ggtitle("Méthode Elbow - Nombre optimal de clusters")
# Méthode silhouette
fviz_nbclust(coords_pca, kmeans, method = "silhouette") +
ggtitle("Méthode Silhouette - Nombre optimal de clusters")
# Gap statistic
set.seed(123)
gap_stat <- clusGap(coords_pca, FUN = kmeans, nstart = 25, K.max = 10, B = 50)
fviz_gap_stat(gap_stat) + ggtitle("Gap Statistic")
# K-means avec k=3 (correspond aux 3 types de vins)
set.seed(123)
kmeans_result <- kmeans(coords_pca, centers = 3, nstart = 25)
cat("\n--- Résultats K-means (k=3) ---\n")
cat("Taille des clusters :\n")
print(table(kmeans_result$cluster))
cat("\nComparaison avec les types réels :\n")
comparaison <- table(Cluster = kmeans_result$cluster, Type_reel = wine$Type)
print(comparaison)
# Taux de bonne classification
taux_accuracy <- sum(diag(comparaison)) / sum(comparaison) * 100
cat("\nTaux de bonne classification :", round(taux_accuracy, 2), "%\n")
# Visualisation des clusters
fviz_cluster(kmeans_result, data = coords_pca,
palette = c("#2E9FDF", "#E7B800", "#FC4E07"),
ellipse.type = "convex", geom = "point",
ggtheme = theme_bw(),
title = "K-means clustering (k=3) sur les composantes principales")
# -----------------------------------------------------------------------------
# 6. Analyse combinée (ACP + Classification)
# -----------------------------------------------------------------------------
cat("\n--- 5. ANALYSE COMBINEE (ACP + CLASSIFICATION) ---\n")
# Projection des clusters sur le plan factoriel
fviz_pca_ind(res.pca, habillage = as.factor(kmeans_result$cluster),
palette = c("#2E9FDF", "#E7B800", "#FC4E07"),
addEllipses = TRUE, ellipse.level = 0.95,
title = "Clusters K-means projetés sur l'ACP")
# Profil des clusters (variables originales)
cat("\n--- Profil des clusters (moyennes des variables) ---\n")
wine_with_cluster <- cbind(wine, Cluster = kmeans_result$cluster)
profil_clusters <- aggregate(wine_with_cluster[,2:14],
by = list(Cluster = wine_with_cluster$Cluster),
FUN = mean)
print(round(profil_clusters, 2))
# Variables discriminantes par cluster
cat("\n--- Variables les plus discriminantes par cluster ---\n")
for(k in 1:3) {
cat("\nCluster", k, ":\n")
cluster_data <- wine_with_cluster[wine_with_cluster$Cluster == k, 2:14]
cluster_means <- colMeans(cluster_data)
global_means <- colMeans(wine[,2:14])
ecart <- cluster_means - global_means
top_vars <- names(sort(abs(ecart), decreasing = TRUE))[1:5]
for(var in top_vars) {
cat("  ", var, ": +", round(ecart[var], 2), "par rapport à la moyenne\n")
}
}
# -----------------------------------------------------------------------------
# 7. Interprétation et conclusion
# -----------------------------------------------------------------------------
cat("\n==========================================")
cat("\n6. INTERPRETATION ET CONCLUSIONS")
cat("\n==========================================\n")
cat("\n--- Résultats de l'ACP ---")
cat("\n• Les 2 premiers axes expliquent", round(eigen_values[1,2] + eigen_values[2,2], 1), "% de la variance")
cat("\n• Axe 1 (", round(eigen_values[1,2], 1), "%) : opposé par")
cat("\n  - Variables positives : Flavanoids, Dilution, Proline, Phenols")
cat("\n  - Variables négatives : Nonflavanoids, Malic, Ash, Alcalinity")
cat("\n• Axe 2 (", round(eigen_values[2,2], 1), "%) : lié à Color et Hue")
cat("\n\n--- Résultats de la classification ---")
cat("\n• 3 clusters identifiés correspondant aux 3 cépages")
cat("\n• Taux de classification :", round(taux_accuracy, 2), "%")
cat("\n• Cluster 1 : Vins riches en alcool, flavonoïdes, proline")
cat("\n• Cluster 2 : Vins équilibrés, valeurs moyennes")
cat("\n• Cluster 3 : Vins plus acides, moins concentrés")
cat("\n\n--- Recommandations business ---")
cat("\n• Segmenter l'offre en 3 gammes de vin (Premium, Standard, Entrée)")
cat("\n• Adapter les campagnes marketing par profil client")
cat("\n• Optimiser la production selon les caractéristiques plébiscitées")
cat("\n\n==========================================")
cat("\nFIN DE L'ANALYSE")
cat("\n==========================================\n")
# -----------------------------------------------------------------------------
# 1. Chargement des packages et données
# -----------------------------------------------------------------------------
library(tidyverse)
library(rattle.data)
library(FactoMineR)
library(factoextra)
library(cluster)
library(corrplot)
data(wine)
cat("\n==========================================")
cat("\nPROJET ANALYSE MULTIVARIEE - DATASET WINE")
